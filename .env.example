# Feedback dashboard access. Use the same email as the ChatGPT login header.
FEEDBACK_ADMIN_EMAIL=

# Notification recipients. Multiple addresses may be separated by commas.
FEEDBACK_NOTIFY_EMAIL=

# A verified sender address for your email provider (for example, Resend).
FEEDBACK_FROM_EMAIL=

# Resend API key. Keep this value in Sites environment variables, never in source control.
RESEND_API_KEY=


